# Origin canonical situs. Dipakai metadata, sitemap.xml, dan robots.txt.
NEXT_PUBLIC_SITE_URL=https://recavix.net

# Penyimpanan Supabase. Secret key hanya dipakai di server — jangan pernah
# diekspos ke browser (variabel tanpa awalan NEXT_PUBLIC_ aman).
# Kalau dua variabel ini kosong, katalog jatuh ke isi bawaan di data/ (read-only).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Password untuk masuk ke /admin.
# SELAMA INI KOSONG, DASHBOARD MENOLAK AKSES (fail-closed), bukan terbuka.
ADMIN_PASSWORD=

# Opsional. Kalau kosong, dipakai turunan dari ADMIN_PASSWORD.
# Isi kalau ingin membatalkan semua sesi lama tanpa mengganti password.
ADMIN_SESSION_SECRET=

# Cloudinary untuk upload gambar dari dashboard (ikon game, logo, QRIS).
# Dipakai lewat unsigned upload, jadi API secret TIDAK dibutuhkan.
# Buat preset-nya sebagai "Unsigned" di Cloudinary → Settings → Upload.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
